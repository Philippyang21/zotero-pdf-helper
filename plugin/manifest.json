{
  "manifest_version": 2,
  "name": "PDF OCR Helper",
  "version": "0.1.16",
  "description": "为 PDF 添加文字层、确认补全版权页书目信息，并在本地整理高亮引用文字。",
  "author": "PDF Repair contributors",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "applications": {
    "zotero": {
      "id": "paddleocr-pdf-repair@local.tools",
      "update_url": "https://paddleocr-pdf-repair.invalid/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
